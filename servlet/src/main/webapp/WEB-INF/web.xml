<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Servlet Learning Project</display-name>
    <description>Dự án học tập Java Servlet cơ bản</description>

    <!-- ============================================== -->
    <!--              WELCOME FILE                       -->
    <!-- File mặc định khi truy cập root URL             -->
    <!-- ============================================== -->
    <welcome-file-list>
        <welcome-file>index.html</welcome-file>
    </welcome-file-list>

    <!-- ============================================== -->
    <!--          SERVLET DECLARATIONS                   -->
    <!-- Khai báo servlet bằng XML (cách truyền thống)   -->
    <!-- Cách hiện đại hơn: dùng @WebServlet annotation  -->
    <!-- ============================================== -->

    <!-- HelloServlet - Servlet cơ bản nhất -->
    <servlet>
        <servlet-name>HelloServlet</servlet-name>
        <servlet-class>com.learn.servlet.HelloServlet</servlet-class>
        <!-- load-on-startup: servlet được khởi tạo khi server start -->
        <!-- Số nhỏ hơn = ưu tiên cao hơn -->
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet-mapping>
        <servlet-name>HelloServlet</servlet-name>
        <url-pattern>/hello</url-pattern>
    </servlet-mapping>

    <!-- ============================================== -->
    <!--          FILTER DECLARATIONS                    -->
    <!-- Filter chạy TRƯỚC khi request đến servlet       -->
    <!-- ============================================== -->
    <filter>
        <filter-name>LoggingFilter</filter-name>
        <filter-class>com.learn.servlet.filter.LoggingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>LoggingFilter</filter-name>
        <!-- /* nghĩa là áp dụng cho TẤT CẢ các URL -->
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============================================== -->
    <!--          SESSION CONFIG                          -->
    <!-- Cấu hình session timeout (phút)                 -->
    <!-- ============================================== -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- ============================================== -->
    <!--          ERROR PAGES                            -->
    <!-- Trang hiển thị khi có lỗi                       -->
    <!-- ============================================== -->
    <error-page>
        <error-code>404</error-code>
        <location>/error/404.html</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error/500.html</location>
    </error-page>

</web-app>
